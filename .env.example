# GEMINI_API_KEY: Optional/Server-side
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# Razorpay Payment Gateway Keys (Indian Payments)
# For testing, you can use Razorpay Test Key ID & Secret or test checkout mode
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_key"

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/umbrella_masterclass"
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Transactional Email (Hostinger Titan Mail / Gmail SMTP)
# For Hostinger Email: host is smtp.hostinger.com, port 465
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="contact@yourdomain.com"
SMTP_PASS="your_hostinger_email_password"
EMAIL_API_KEY="re_placeholder_api_key"
ADMIN_EMAIL="caumbrellanetwork@gmail.com"

# Masterclass Google Drive Resources Folder
GOOGLE_DRIVE_RESOURCES_URL="https://drive.google.com/drive/u/4/folders/1Tq4a24HL9V4SxrEFsjfOpSMLK085_6nD"

# Admin Authentication
ADMIN_TOKEN="umbrella_admin_secret_token_2026"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="admin123"

# Optional Hostinger custom port (defaults to 3000)
HOSTINGER_PORT="3000"

